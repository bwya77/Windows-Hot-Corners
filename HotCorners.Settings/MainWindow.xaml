<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="HotCorners.SettingsApp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar (drag region) -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="40" Padding="14,0,0,0">
            <TextBlock x:Name="TitleText"
                       Text="Hot Corners"
                       VerticalAlignment="Center"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

        <muxc:NavigationView x:Name="Nav" Grid.Row="1"
                             IsBackButtonVisible="Collapsed"
                             IsSettingsVisible="False"
                             PaneDisplayMode="Left"
                             OpenPaneLength="190"
                             IsPaneToggleButtonVisible="False"
                             SelectionChanged="Nav_SelectionChanged">
            <muxc:NavigationView.MenuItems>
                <muxc:NavigationViewItem Content="Corners" Tag="corners" IsSelected="True">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE744;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Behavior" Tag="behavior">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="Updates" Tag="updates">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE777;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
                <muxc:NavigationViewItem Content="About" Tag="about">
                    <muxc:NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </muxc:NavigationViewItem.Icon>
                </muxc:NavigationViewItem>
            </muxc:NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="28,12,28,28">

                    <!-- CORNERS -->
                    <StackPanel x:Name="CornersPane" Spacing="18">
                        <TextBlock Text="Corners" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,2" />
                        <TextBlock Text="Move your cursor into a screen corner to trigger an action."
                                   Style="{StaticResource BodyTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- The macOS-style screen preview. The "screen" is a rounded gradient
                             rectangle with a soft shadow; the four corner ComboBoxes float just
                             inside its corners. -->
                        <Border HorizontalAlignment="Center"
                                CornerRadius="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Padding="22,20">
                            <Grid x:Name="ScreenPreview" Width="640" Height="360">
                                <Border x:Name="ScreenBackground"
                                        CornerRadius="14"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource ControlElevationBorderBrush}">
                                    <!-- Default gradient is the fallback; MainWindow.xaml.cs
                                         swaps in the user's actual desktop wallpaper on launch
                                         and whenever the window regains focus. -->
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3A4C82" Offset="0.0" />
                                            <GradientStop Color="#5C76B8" Offset="0.5" />
                                            <GradientStop Color="#8DA3D6" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Corner combos. Each is inset 14px so the dropdowns sit
                                     visually inside the "screen" rather than on its edge. -->
                                <ComboBox x:Name="TopLeftCombo"
                                          HorizontalAlignment="Left" VerticalAlignment="Top"
                                          Margin="14,14,0,0" Width="190"
                                          SelectionChanged="OnTopLeftChanged" />
                                <ComboBox x:Name="TopRightCombo"
                                          HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,14,14,0" Width="190"
                                          SelectionChanged="OnTopRightChanged" />
                                <ComboBox x:Name="BottomLeftCombo"
                                          HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                          Margin="14,0,0,14" Width="190"
                                          SelectionChanged="OnBottomLeftChanged" />
                                <ComboBox x:Name="BottomRightCombo"
                                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                          Margin="0,0,14,14" Width="190"
                                          SelectionChanged="OnBottomRightChanged" />
                            </Grid>
                        </Border>

                        <TextBlock TextWrapping="Wrap" Margin="2,4,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}">
                            Settings save instantly. With multiple monitors, a corner only fires when there's no neighboring display in either direction.
                        </TextBlock>
                    </StackPanel>

                    <!-- BEHAVIOR -->
                    <StackPanel x:Name="BehaviorPane" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Behavior" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,2" />

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Dwell time" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="How long the cursor must rest in a corner before firing."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Slider x:Name="DwellSlider"
                                            Minimum="25" Maximum="600"
                                            StepFrequency="25"
                                            TickFrequency="0"
                                            Width="240"
                                            Value="150"
                                            ValueChanged="OnDwellChanged" />
                                    <TextBlock x:Name="DwellValueText"
                                               Text="150 ms"
                                               MinWidth="56"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Show corner overlay" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Fade in a translucent puddle in the corner as you dwell there, and ripple it outward when the action fires. Click-through, just like macOS."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="ShowOverlayToggle" Toggled="OnShowOverlayToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="Monitors" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Choose which displays have their outer corners armed."
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                                <muxc:RadioButtons x:Name="MonitorModeRadio"
                                                   MaxColumns="1"
                                                   Margin="0,6,0,0"
                                                   SelectionChanged="OnMonitorModeChanged">
                                    <x:String>All monitors</x:String>
                                    <x:String>Primary monitor only</x:String>
                                </muxc:RadioButtons>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Skip in fullscreen apps" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Don't trigger while a fullscreen app (game, full-screen video) is in the foreground. Windows shell — Task View, Start, Search — is exempt."
                                               TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="SuppressFullscreenToggle" Toggled="OnSuppressToggled" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="Launch Hot Corners automatically when you sign in."
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                                <ToggleSwitch Grid.Column="1" x:Name="LaunchAtLoginToggle" Toggled="OnLaunchAtLoginToggled" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- UPDATES -->
                    <StackPanel x:Name="UpdatesPane" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="Updates" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,2" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="Hot Corners" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock x:Name="UpdatesVersionText" Text="v0.0.0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                    <Button x:Name="CheckUpdatesButton" Grid.Column="1"
                                            Content="Check for Updates"
                                            Click="OnCheckForUpdates"
                                            Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                                <TextBlock x:Name="UpdatesStatusText"
                                           Text=""
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           TextWrapping="Wrap"
                                           Visibility="Collapsed" />
                                <muxc:InfoBar x:Name="UpdatesInfoBar"
                                              IsOpen="False"
                                              IsClosable="True"
                                              Severity="Informational" />
                            </StackPanel>
                        </Border>

                        <TextBlock TextWrapping="Wrap" Margin="2,4,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Style="{StaticResource CaptionTextBlockStyle}">
                            Hot Corners also checks for updates in the background every 24 hours and shows a notification when a new version is available.
                        </TextBlock>
                    </StackPanel>

                    <!-- ABOUT -->
                    <StackPanel x:Name="AboutPane" Spacing="14" Visibility="Collapsed">
                        <TextBlock Text="About" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,2" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Border Width="64" Height="64" CornerRadius="14"
                                            VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#3A4C82" Offset="0.0" />
                                                <GradientStop Color="#8DA3D6" Offset="1.0" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <FontIcon Glyph="&#xE744;" FontSize="32" Foreground="White" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Hot Corners for Windows" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock x:Name="AboutVersionText" Text="Version 0.0.0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Style="{StaticResource CaptionTextBlockStyle}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource BodyTextBlockStyle}">
                                    macOS-style hot corners for Windows. Move your cursor into a corner of your screen, hold it briefly, and a configurable action fires.
                                </TextBlock>
                                <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,4,0,0">
                                    <HyperlinkButton Content="View on GitHub" NavigateUri="https://github.com/bwya77/Windows-Hot-Corners" />
                                    <HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/bwya77/Windows-Hot-Corners/issues" />
                                    <HyperlinkButton Content="Releases" NavigateUri="https://github.com/bwya77/Windows-Hot-Corners/releases" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="License" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Style="{StaticResource BodyTextBlockStyle}">
                                    MIT License — Copyright © 2026 Bradley Wyatt
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </muxc:NavigationView>
    </Grid>
</Window>

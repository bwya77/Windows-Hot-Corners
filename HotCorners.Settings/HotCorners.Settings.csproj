<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HotCorners.SettingsApp</RootNamespace>
    <AssemblyName>HotCorners.Settings</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Product>Hot Corners</Product>
    <AssemblyTitle>Hot Corners Settings</AssemblyTitle>
    <Company>bwya77</Company>
    <Copyright>Copyright © 2026 Bradley Wyatt</Copyright>
    <!-- Self-contained Windows App Runtime bundles an AI/ML runtime we never call;
         the release workflow deletes those native DLLs after publish to trim size. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260508005" />
  </ItemGroup>

  <!-- Share the settings model, enums, action labels, and update checker with the tray
       app by linking the source files rather than maintaining a separate library. -->
  <ItemGroup>
    <Compile Include="..\Settings\AppSettings.cs" Link="Shared\AppSettings.cs" />
    <Compile Include="..\Settings\SettingsStore.cs" Link="Shared\SettingsStore.cs" />
    <Compile Include="..\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\ActionLabels.cs" Link="Shared\ActionLabels.cs" />
    <Compile Include="..\Updates\UpdateChecker.cs" Link="Shared\UpdateChecker.cs" />
  </ItemGroup>

</Project>

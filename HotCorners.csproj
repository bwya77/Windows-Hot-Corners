<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotCorners</RootNamespace>
    <AssemblyName>HotCorners</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Hot Corners</Product>
    <AssemblyTitle>Hot Corners for Windows</AssemblyTitle>
    <Company>bwya77</Company>
    <Copyright>Copyright © 2026 Bradley Wyatt</Copyright>
    <Description>macOS-style hot corners for Windows.</Description>
  </PropertyGroup>

  <!-- The standalone WinUI 3 settings app lives in this subfolder of the repo root.
       Exclude it from the WinForms app's default globbing so it builds as its own project. -->
  <ItemGroup>
    <Compile Remove="HotCorners.Settings\**" />
    <Page Remove="HotCorners.Settings\**" />
    <ApplicationDefinition Remove="HotCorners.Settings\**" />
    <None Remove="HotCorners.Settings\**" />
    <EmbeddedResource Remove="HotCorners.Settings\**" />
    <Content Remove="HotCorners.Settings\**" />
  </ItemGroup>

</Project>


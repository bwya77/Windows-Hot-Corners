<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HotCorners</RootNamespace>
    <AssemblyName>HotCorners</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Hot Corners</Product>
    <AssemblyTitle>Hot Corners for Windows</AssemblyTitle>
    <Company>bwya77</Company>
    <Copyright>Copyright © 2026 Bradley Wyatt</Copyright>
    <Description>macOS-style hot corners for Windows.</Description>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The standalone WinUI 3 settings app lives in this subfolder of the repo root.
       Exclude it from the WinForms app's default globbing so it builds as its own project. -->
  <ItemGroup>
    <Compile Remove="HotCorners.Settings\**" />
    <Page Remove="HotCorners.Settings\**" />
    <ApplicationDefinition Remove="HotCorners.Settings\**" />
    <None Remove="HotCorners.Settings\**" />
    <EmbeddedResource Remove="HotCorners.Settings\**" />
    <Content Remove="HotCorners.Settings\**" />
  </ItemGroup>

  <!-- Embed the tray-optimized icon (16/20/24/32 only) so TrayContext can load it
       at runtime without depending on extracted files. ApplicationIcon above wires
       the full multi-size icon.ico into the exe's icon resource so File Explorer,
       the Start menu, Alt-Tab, and the installer's UninstallDisplayIcon all see it. -->
  <ItemGroup>
    <EmbeddedResource Include="assets\icon-tray.ico">
      <LogicalName>HotCorners.icon-tray.ico</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>

